# ==============================================================================
# CortexGraph Environment Configuration
# ==============================================================================

# OpenAI API Configuration
OPENAI_API_KEY=sk-placeholder-for-local-dev
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ChromaDB Configuration
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=cortexgraph_vault

# Langfuse Observability
LANGFUSE_PUBLIC_KEY=pk-lf-placeholder
LANGFUSE_SECRET_KEY=sk-lf-placeholder
LANGFUSE_HOST=https://cloud.langfuse.com

# NVIDIA Auto-Ontology MCP Configuration
AUTO_ONTOLOGY_MCP_URL=http://localhost:3003/mcp

# Telemetry & Structured Logging (console | json)
LOG_FORMAT=console
LOG_LEVEL=INFO

# Application Server
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
